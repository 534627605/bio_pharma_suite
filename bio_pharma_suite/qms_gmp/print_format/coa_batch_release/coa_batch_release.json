{
 "doctype": "Print Format",
 "name": "COA Batch Release",
 "module": "QMS GMP",
 "doc_type": "Batch Release Record",
 "print_format_type": "Jinja",
 "standard": "Yes",
 "html": "<div style=\"font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto;\">\n<div style=\"text-align: center; border-bottom: 3px double #333; padding-bottom: 12px; margin-bottom: 16px;\">\n<h2 style=\"margin: 0;\">{{ _(\"Certificate of Analysis\") }}</h2>\n<div style=\"font-size: 13px; color: #555;\">{{ _(\"Batch Release Record\") }}: {{ doc.name }}</div>\n</div>\n\n<table style=\"width: 100%; border-collapse: collapse; font-size: 13px;\">\n<tr>\n<td style=\"padding: 6px 10px; border: 1px solid #ccc; background: #f5f5f5; width: 22%;\">{{ _(\"Item Code\") }}</td>\n<td style=\"padding: 6px 10px; border: 1px solid #ccc;\">{{ doc.item_code }}</td>\n<td style=\"padding: 6px 10px; border: 1px solid #ccc; background: #f5f5f5; width: 22%;\">{{ _(\"Batch No\") }}</td>\n<td style=\"padding: 6px 10px; border: 1px solid #ccc;\">{{ doc.batch_no }}</td>\n</tr>\n<tr>\n<td style=\"padding: 6px 10px; border: 1px solid #ccc; background: #f5f5f5;\">{{ _(\"Manufacturing Date\") }}</td>\n<td style=\"padding: 6px 10px; border: 1px solid #ccc;\">{{ doc.manufacturing_date or \"-\" }}</td>\n<td style=\"padding: 6px 10px; border: 1px solid #ccc; background: #f5f5f5;\">{{ _(\"Expiry Date\") }}</td>\n<td style=\"padding: 6px 10px; border: 1px solid #ccc;\">{{ doc.expiry_date or \"-\" }}</td>\n</tr>\n</table>\n\n<h4 style=\"margin: 18px 0 8px;\">{{ _(\"Quality Inspection Summary\") }}</h4>\n<table style=\"width: 100%; border-collapse: collapse; font-size: 13px;\">\n<thead>\n<tr style=\"background: #eee;\">\n<th style=\"padding: 6px 10px; border: 1px solid #ccc; text-align: left;\">{{ _(\"Inspection\") }}</th>\n<th style=\"padding: 6px 10px; border: 1px solid #ccc; text-align: left;\">{{ _(\"Item Code\") }}</th>\n<th style=\"padding: 6px 10px; border: 1px solid #ccc; text-align: left;\">{{ _(\"Status\") }}</th>\n</tr>\n</thead>\n<tbody>\n{% for qi in frappe.get_all(\"Quality Inspection\", filters={\"batch_no\": doc.batch_no, \"docstatus\": 1}, fields=[\"name\", \"item_code\", \"status\", \"report_date\"], order_by=\"report_date asc\") %}\n<tr>\n<td style=\"padding: 5px 10px; border: 1px solid #ccc;\">{{ qi.name }} ({{ qi.report_date }})</td>\n<td style=\"padding: 5px 10px; border: 1px solid #ccc;\">{{ qi.item_code }}</td>\n<td style=\"padding: 5px 10px; border: 1px solid #ccc;\">{{ qi.status }}</td>\n</tr>\n{% endfor %}\n</tbody>\n</table>\n\n<table style=\"width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 14px;\">\n<tr>\n<td style=\"padding: 6px 10px; border: 1px solid #ccc; background: #f5f5f5; width: 30%;\">{{ _(\"Total Inspections\") }}</td>\n<td style=\"padding: 6px 10px; border: 1px solid #ccc;\">{{ doc.qi_total }} &nbsp;|&nbsp; {{ _(\"Rejected\") }}: {{ doc.qi_rejected }}</td>\n</tr>\n<tr>\n<td style=\"padding: 6px 10px; border: 1px solid #ccc; background: #f5f5f5;\">{{ _(\"Release Decision\") }}</td>\n<td style=\"padding: 6px 10px; border: 1px solid #ccc;\"><strong>{{ doc.release_decision }}</strong> ({{ doc.release_effective_date or \"-\" }})</td>\n</tr>\n</table>\n\n<div style=\"display: flex; margin-top: 40px; font-size: 13px;\">\n<div style=\"flex: 1; text-align: center;\">\n<div style=\"border-top: 1px solid #333; width: 70%; margin: 0 auto; padding-top: 6px;\">\n{{ _(\"Prepared By\") }}<br>{{ doc.prepared_by or \"-\" }}\n</div>\n</div>\n<div style=\"flex: 1; text-align: center;\">\n<div style=\"border-top: 1px solid #333; width: 70%; margin: 0 auto; padding-top: 6px;\">\n{{ _(\"Qualified Person\") }}<br>{{ doc.qp_approver or \"-\" }}\n</div>\n</div>\n</div>\n\n<div style=\"margin-top: 24px; font-size: 11px; color: #777; text-align: center;\">\n{{ _(\"This certificate is electronically generated and controlled under 21 CFR Part 11 / GMP Annex 11.\") }}\n</div>\n</div>",
 "align_labels_right": 0,
 "absolute_value": 0,
 "margin_top": 10.0,
 "margin_bottom": 10.0,
 "margin_left": 12.0,
 "margin_right": 12.0,
 "font_size": 13,
 "letterhead": null,
 "disabled": 0
}