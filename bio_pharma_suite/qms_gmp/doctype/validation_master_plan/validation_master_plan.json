   "fieldtype": "Section Break",
   "label": "Plan Section"
  },
  {
   "fieldname": "plan_year",
   "fieldtype": "Int",
   "label": "Plan Year",
   "reqd": 1
  },
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1
  },
  {
   "fieldname": "col_p",
   "fieldtype": "Column Break",
   "label": "Col P"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nActive\nCompleted",
   "default": "Draft"
  },
  {
   "fieldname": "responsible",
   "fieldtype": "Link",
   "label": "Responsible",
   "options": "User"
  },
  {
   "fieldname": "scope_section",
   "fieldtype": "Section Break",
   "label": "Scope Section"
  },
  {
   "fieldname": "validation_scope",
   "fieldtype": "Small Text",
   "label": "Validation Scope"
  },
  {
   "fieldname": "activities",
   "fieldtype": "Table",
   "label": "Validation Activities",
   "reqd": 1,
   "options": "Validation Activity"
  },
  {
   "fieldname": "summary_section",
   "fieldtype": "Section Break",
   "label": "Summary Section"
  },
  {
   "fieldname": "total_activities",
   "fieldtype": "Int",
   "label": "Total Activities",
   "read_only": 1
  },
  {
   "fieldname": "col_s2",
   "fieldtype": "Column Break",
   "label": "Col S2"
  },
  {
   "fieldname": "overdue_count",
   "fieldtype": "Int",
   "label": "Overdue Count",
   "read_only": 1
  },
  {
   "fieldname": "close_section",
   "fieldtype": "Section Break",
   "label": "Close Section"
  },
  {
   "fieldname": "esign_confirmed",
   "fieldtype": "Check",
   "label": "E-Signature Confirmed"
  },
  {
   "fieldname": "closed_on",
   "fieldtype": "Date",
   "label": "Closed On"
  }
 ],
