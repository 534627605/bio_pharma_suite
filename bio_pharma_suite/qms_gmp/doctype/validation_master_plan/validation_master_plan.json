   "submit": 1,
   "cancel": 1,
   "report": 1,
   "share": 1
  },
  {
   "role": "Bio Pharma QA Officer",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "report": 1,
   "share": 1
  },
  {
   "role": "Bio Pharma QP",
   "read": 1,
   "write": 1,
   "submit": 1,
   "report": 1
  },
  {
   "role": "Bio Pharma QC Analyst",
   "read": 1,
   "report": 1
  }
 ],
 "track_changes": 1
}