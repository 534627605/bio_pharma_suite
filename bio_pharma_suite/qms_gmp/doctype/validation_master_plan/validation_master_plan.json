{
 "doctype": "DocType",
 "name": "Validation Master Plan",
 "module": "QMS GMP",
 "autoname": "format:VMP-{YY}-{#####}",
 "is_submittable": 1,
 "engine": "InnoDB",
 "field_order": [
  "plan_section",
  "plan_year",
  "title",
  "col_p",
  "status",
  "responsible",
  "scope_section",
  "validation_scope",
  "activities",
  "summary_section",
  "total_activities",
  "col_s2",
  "overdue_count",
  "close_section",
  "esign_confirmed",
  "closed_on"
 ],
 "fields": [
