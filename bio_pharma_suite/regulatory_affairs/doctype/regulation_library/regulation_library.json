    {"fieldname":"effective_upto","fieldtype":"Date","label":"Effective Upto"},
    {"fieldname":"status","fieldtype":"Select","label":"Status","options":"Draft\nIn Review\nApproved\nWithdrawn"},
    {"fieldname":"section_clauses","fieldtype":"Section Break","label":"Clauses"},
    {"fieldname":"clauses","fieldtype":"Table","label":"Regulation Clauses","options":"Regulation Clause"},
    {"fieldname":"remarks","fieldtype":"Small Text","label":"Remarks"}
  ],
  "links": [],
  "permissions": [
    {"role":"System Manager","read":1,"write":1,"create":1,"delete":1,"report":1,"share":1},
    {"role":"Bio Pharma QA Officer","read":1,"write":1,"create":1},
    {"role":"Bio Pharma QP","read":1,"write":1}
  ],
  "index_web_pages_for_search": 1
