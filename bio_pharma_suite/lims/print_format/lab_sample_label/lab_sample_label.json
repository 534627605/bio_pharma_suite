{
 "custom_format": 1,
 "doc_type": "Lab Sample",
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div style=\"font-family: sans-serif; border: 1.5px solid #333; padding: 10px; width: 320px;\">\n  <div style=\"text-align:center; font-weight:bold; font-size:16px; border-bottom:1px solid #999; padding-bottom:6px;\">\n    {{ _(\"Lab Sample Label\") }}\n  </div>\n  <table style=\"width:100%; font-size:12px; margin-top:6px;\">\n    <tr><td>{{ _(\"Sample No\") }}</td><td style=\"font-weight:bold; font-size:14px;\">{{ doc.sample_no }}</td></tr>\n    {% if doc.item_code %}<tr><td>{{ _(\"Item\") }}</td><td>{{ doc.item_code }}</td></tr>{% endif %}\n    {% if doc.batch_no %}<tr><td>{{ _(\"Batch\") }}</td><td>{{ doc.batch_no }}</td></tr>{% endif %}\n    <tr><td>{{ _(\"Status\") }}</td><td>{{ doc.sample_status }}</td></tr>\n    {% if doc.storage_zone %}<tr><td>{{ _(\"Storage Zone\") }}</td><td>{{ doc.storage_zone }}</td></tr>{% endif %}\n    {% if doc.due_date %}<tr><td>{{ _(\"Due Date\") }}</td><td>{{ frappe.utils.formatdate(doc.due_date) }}</td></tr>{% endif %}\n  </table>\n  <div style=\"text-align:center; margin-top:8px;\">\n    <img src=\"{{ frappe.get_attr('frappe.utils.print_format_generator.get_qr_code')(doc.sample_qr) }}\" style=\"width:110px; height:110px;\"/>\n    <div style=\"font-family: monospace; font-size:12px; letter-spacing:2px;\">{{ doc.sample_barcode }}</div>\n  </div>\n</div>",
